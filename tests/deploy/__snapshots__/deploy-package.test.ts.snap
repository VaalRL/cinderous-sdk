exports[`renderDeployPackage：每個目標的檔案（快照） > home-tunnel > docker-compose.yml 1`] = `
"# SPDX-License-Identifier: MIT-0
# 由 \`cinderous relay build\`（@cinderous/client 0.0.0-test）依 cinderous.config.json 產生；以 MIT-0 授權（見 SOURCE.md）。SDK 本體是 AGPL-3.0-only。
# Generated by \`cinderous relay build\` (@cinderous/client 0.0.0-test) from cinderous.config.json; MIT-0 (see SOURCE.md). The SDK itself is AGPL-3.0-only.
services:
  relay:
    build: .
    container_name: home
    restart: unless-stopped
    expose:
      - "8080"
    environment:
      MAX_CONNECTIONS_PER_PUBKEY: "5"
      MAX_MESSAGES_PER_SECOND_PER_IP: "20"
      ALLOWED_PUBKEYS: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa1"
      MAX_FILE_MB: "17"
      RELAY_SOFTWARE_URL: "https://git.example.com/me/fork"
      PERSIST: "1"
      DB_PATH: "/data/relay.db"
      TRUST_PROXY: "1"
    volumes:
      - relay-data:/data
  cloudflared:
    image: "cloudflare/cloudflared:latest"
    container_name: home-tunnel
    restart: unless-stopped
    command: ["tunnel", "--no-autoupdate", "run"]
    environment:
      TUNNEL_TOKEN: "\${TUNNEL_TOKEN:?請在 .env 設定 TUNNEL_TOKEN（Cloudflare Tunnel Token）}"
    depends_on:
      - relay
volumes:
  relay-data: {}
"
`;


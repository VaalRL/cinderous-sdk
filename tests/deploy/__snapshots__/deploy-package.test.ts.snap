exports[`renderDeployPackage：每個目標的檔案（快照） > home-tunnel > server.mjs 1`] = `
"// SPDX-License-Identifier: MIT-0
// 由 \`cinderous relay build\`（@cinderous/client 0.0.0-test）依 cinderous.config.json 產生；以 MIT-0 授權（見 SOURCE.md）。SDK 本體是 AGPL-3.0-only。
// Generated by \`cinderous relay build\` (@cinderous/client 0.0.0-test) from cinderous.config.json; MIT-0 (see SOURCE.md). The SDK itself is AGPL-3.0-only.
import { setRelayVersion } from '@cinderous/client/relay';
import { startNodeRelay } from '@cinderous/client/relay/node';

setRelayVersion(process.env.RELAY_VERSION ?? '0.0.0');
// PERSIST=1 才寫 SQLite（DB_PATH 在掛好的 volume 上）；否則純記憶體，重啟即清空（SDK ADR 0008）
startNodeRelay(process.env, { memory: process.env.PERSIST !== '1' });
"
`;

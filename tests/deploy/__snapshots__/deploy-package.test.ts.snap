"# SPDX-License-Identifier: MIT-0
# 由 \`cinderous relay build\`（@cinderous/client 0.0.0-test）依 cinderous.config.json 產生；以 MIT-0 授權（見 SOURCE.md）。SDK 本體是 AGPL-3.0-only。
# Generated by \`cinderous relay build\` (@cinderous/client 0.0.0-test) from cinderous.config.json; MIT-0 (see SOURCE.md). The SDK itself is AGPL-3.0-only.
app = "fly-relay"
primary_region = "sin"

[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "8080"
  MAX_CONNECTIONS_PER_PUBKEY = "5"
  MAX_MESSAGES_PER_SECOND_PER_IP = "20"
  ALLOWED_PUBKEYS = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa1"
  PERSIST = "1"
  DB_PATH = "/data/relay.db"
  TRUST_PROXY = "1"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    grace_period = "10s"
    interval = "30s"
    method = "GET"
    path = "/healthz"
    timeout = "5s"

[[mounts]]
  source = "relay_data"
  destination = "/data"
"
`;


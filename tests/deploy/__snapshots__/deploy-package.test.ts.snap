"# SPDX-License-Identifier: MIT-0
# 由 \`cinderous relay build\`（@cinderous/client 0.0.0-test）依 cinderous.config.json 產生；以 MIT-0 授權（見 SOURCE.md）。SDK 本體是 AGPL-3.0-only。
# Generated by \`cinderous relay build\` (@cinderous/client 0.0.0-test) from cinderous.config.json; MIT-0 (see SOURCE.md). The SDK itself is AGPL-3.0-only.
FROM node:22-slim
WORKDIR /app
# 先裝相依再放程式：程式改了不必重裝相依
COPY package.json ./
COPY sdk ./sdk
RUN npm install --omit=dev --no-audit --no-fund
COPY server.mjs ./
ENV PORT=8080 RELAY_VERSION=0.0.0-test
EXPOSE 8080
# node:22 的 node:sqlite 需要這個旗標（保存模式用；純記憶體模式不會載入它）
CMD ["node", "--experimental-sqlite", "server.mjs"]
"
`;

